package views

import (
	"fmt"
	"github.com/thornzero/movie-poll/types"
	"strconv"
	"strings"
)

// EnhancedMovieCard represents an enhanced movie card with additional features
type EnhancedMovieCard struct {
	MovieCard
	Genres     []string `json:"genres,omitempty"`
	Runtime    *int     `json:"runtime,omitempty"`
	Rating     *float64 `json:"rating,omitempty"`
	Director   *string  `json:"director,omitempty"`
	Cast       []string `json:"cast,omitempty"`
	Popularity *float64 `json:"popularity,omitempty"`
	VoteCount  int      `json:"vote_count"`
	HasTrailer bool     `json:"has_trailer"`
	TrailerURL *string  `json:"trailer_url,omitempty"`
}

// EnhancedMovieCardTemplate renders an enhanced movie card with better UI and controls
templ EnhancedMovieCardTemplate(movie EnhancedMovieCard, hasVoted bool, userVote types.Vote) {
	<div class="swiper-slide">
		<div class="enhanced-movie-card bg-gradient-to-br from-goat-700 to-goat-800 p-4 sm:p-6 rounded-xl text-center w-full max-w-sm sm:max-w-md lg:max-w-lg xl:max-w-xl mx-auto shadow-2xl border border-goat-600 hover:border-tavern-500 transition-all duration-500 hover:shadow-tavern-500/20 hover:shadow-2xl group">
			<!-- Movie Poster with Enhanced Overlay -->
			<div class="movie-poster mb-6 relative overflow-hidden rounded-lg">
				if movie.PosterPath != nil && *movie.PosterPath != "" {
					<img
						src={ "https://image.tmdb.org/t/p/w300" + *movie.PosterPath }
						alt={ movie.Title }
						class="w-full h-64 sm:h-72 lg:h-80 object-cover rounded-lg mx-auto shadow-lg group-hover:scale-105 transition-transform duration-500"
					/>
				} else {
					<div class="w-full h-64 sm:h-72 lg:h-80 bg-gradient-to-br from-goat-600 via-goat-500 to-tavern-600 rounded-lg mx-auto flex items-center justify-center shadow-lg">
						<div class="text-center">
							<div class="text-4xl sm:text-5xl mb-2">🎬</div>
							<span class="text-goat-200 text-sm sm:text-base font-medium">{ movie.Title }</span>
						</div>
					</div>
				}
				<!-- Enhanced Overlay with Movie Info -->
				<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300">
					<div class="absolute bottom-4 left-4 right-4 text-white">
						<!-- Movie Stats -->
						<div class="flex items-center justify-between mb-2">
							if movie.Rating != nil {
								<div class="flex items-center gap-1">
									<span class="text-yellow-400">⭐</span>
									<span class="text-sm font-semibold">{ fmt.Sprintf("%.1f", *movie.Rating) }</span>
								</div>
							}
							if movie.Runtime != nil {
								<div class="flex items-center gap-1">
									<span class="text-blue-400">⏱️</span>
									<span class="text-sm">{ *movie.Runtime }m</span>
								</div>
							}
						</div>
						<!-- Genres -->
						if len(movie.Genres) > 0 {
							<div class="flex flex-wrap gap-1 mb-2">
								for _, genre := range movie.Genres {
									<span class="bg-tavern-500/80 text-white text-xs px-2 py-1 rounded-full">
										{ genre }
									</span>
								}
							</div>
						}
					</div>
				</div>
				<!-- Year Badge with Enhanced Styling -->
				if movie.Year != nil {
					<div class="absolute top-3 right-3 bg-gradient-to-r from-tavern-500 to-tavern-400 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg backdrop-blur-sm">
						{ *movie.Year }
					</div>
				}
				<!-- Trailer Button -->
				if movie.HasTrailer && movie.TrailerURL != nil {
					<div class="absolute top-3 left-3">
						<a href={ *movie.TrailerURL } target="_blank" class="bg-red-600/90 hover:bg-red-500 text-white p-2 rounded-full shadow-lg backdrop-blur-sm transition-all duration-200 hover:scale-110 inline-block">
							<span class="text-sm">▶️</span>
						</a>
					</div>
				}
			</div>
			<!-- Enhanced Movie Info -->
			<div class="movie-info">
				<!-- Title with Better Typography -->
				<h3 class="text-xl sm:text-2xl lg:text-3xl font-bold text-tavern-400 mb-3 leading-tight group-hover:text-tavern-300 transition-colors duration-300">{ movie.Title }</h3>
				<!-- Director and Cast Info -->
				if movie.Director != nil {
					<p class="text-goat-300 text-sm mb-2">
						<span class="text-tavern-500 font-medium">Director:</span> { *movie.Director }
					</p>
				}
				if len(movie.Cast) > 0 {
					<p class="text-goat-300 text-sm mb-4">
						<span class="text-tavern-500 font-medium">Cast:</span> { strings.Join(movie.Cast[:min(3, len(movie.Cast))], ", ") }
					</p>
				}
				<!-- Enhanced Voting Step Indicator -->
				if !hasVoted {
					<div class="mb-4">
						@EnhancedVotingStepIndicator("seen", movie.Title, movie.VoteCount)
					</div>
				}
				<!-- Enhanced Overview with Better Styling -->
				if movie.Overview != nil && *movie.Overview != "" {
					<div class="bg-goat-600/50 rounded-lg p-4 mb-6">
						<p class="text-goat-300 text-sm sm:text-base leading-relaxed line-clamp-4">{ *movie.Overview }</p>
					</div>
				}
				<!-- Enhanced Voting Interface -->
				<div id={ "voting-interface-" + strconv.Itoa(movie.ID) } class="voting-interface">
					if hasVoted {
						@EnhancedVotedState(movie.ID, userVote)
					} else {
						@EnhancedVotingInterface(movie.ID)
					}
				</div>
			</div>
		</div>
	</div>
}

// EnhancedVotingStepIndicator with vote count and better styling
templ EnhancedVotingStepIndicator(currentStep string, movieTitle string, voteCount int) {
	<div class="enhanced-step-indicator bg-gradient-to-r from-goat-600/80 to-goat-500/80 backdrop-blur-sm rounded-lg p-4 mb-4 border border-goat-500/30">
		<div class="flex items-center justify-between mb-3">
			<div class="flex items-center space-x-2">
				<div class="w-3 h-3 bg-tavern-500 rounded-full animate-pulse shadow-lg"></div>
				<span class="text-sm font-medium text-goat-200">Current Movie</span>
			</div>
			<div class="text-right">
				<div class="text-sm text-tavern-400 font-medium truncate max-w-32" title={ movieTitle }>{ movieTitle }</div>
				<div class="text-xs text-goat-400">Step: { currentStep }</div>
			</div>
		</div>
		<!-- Enhanced Step Progress with Vote Count -->
		<div class="flex items-center space-x-2">
			if currentStep == "seen" {
				<div class="w-3 h-3 rounded-full shadow-lg bg-tavern-500 ring-2 ring-tavern-300"></div>
			} else {
				<div class="w-3 h-3 rounded-full shadow-lg bg-green-500 ring-2 ring-green-300"></div>
			}
			<div class="text-xs text-goat-400">Seen Status</div>
			<div class="flex-1 h-px bg-gradient-to-r from-goat-600 to-goat-500"></div>
			if currentStep == "rating" || currentStep == "interest" {
				<div class="w-3 h-3 rounded-full shadow-lg bg-tavern-500 ring-2 ring-tavern-300"></div>
			} else if currentStep == "complete" {
				<div class="w-3 h-3 rounded-full shadow-lg bg-green-500 ring-2 ring-green-300"></div>
			} else {
				<div class="w-3 h-3 rounded-full shadow-lg bg-goat-500 ring-2 ring-goat-300"></div>
			}
			<div class="text-xs text-goat-400">Rating</div>
			<div class="flex-1 h-px bg-gradient-to-r from-goat-600 to-goat-500"></div>
			if currentStep == "complete" {
				<div class="w-3 h-3 rounded-full shadow-lg bg-green-500 ring-2 ring-green-300"></div>
			} else {
				<div class="w-3 h-3 rounded-full shadow-lg bg-goat-500 ring-2 ring-goat-300"></div>
			}
			<div class="text-xs text-goat-400">Complete</div>
		</div>
		<!-- Vote Count Indicator -->
		if voteCount > 0 {
			<div class="mt-2 text-center">
				<span class="bg-tavern-500/20 text-tavern-300 text-xs px-2 py-1 rounded-full border border-tavern-500/30">
					{ voteCount } votes so far
				</span>
			</div>
		}
	</div>
}

// EnhancedVotingInterface with better visual design
templ EnhancedVotingInterface(movieID int) {
	<div class="space-y-6">
		<!-- Enhanced Seen Question -->
		<div class="enhanced-seen-section">
			<div class="bg-gradient-to-r from-goat-600/80 to-goat-500/80 backdrop-blur-sm rounded-xl p-6 mb-6 border border-goat-500/30">
				<div class="text-center mb-4">
					<div class="text-3xl mb-2">🎬</div>
					<p class="text-lg sm:text-xl text-goat-200 font-bold mb-2">Have you seen this movie?</p>
					<p class="text-sm text-goat-400">Choose your experience level to continue</p>
				</div>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				<form hx-post="/api/voting/seen" hx-target={ "#voting-interface-" + strconv.Itoa(movieID) } hx-swap="innerHTML" class="group">
					<input type="hidden" name="movie_id" value={ strconv.Itoa(movieID) }/>
					<input type="hidden" name="seen" value="true"/>
					<button type="submit" class="btn-primary w-full text-base py-4 flex flex-col items-center gap-3 hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-xl border-2 border-transparent hover:border-green-300">
						<span class="text-3xl group-hover:scale-110 transition-transform duration-200">✅</span>
						<span class="font-semibold">Yes, I've seen it</span>
						<span class="text-sm opacity-80">Rate your experience</span>
					</button>
				</form>
				<form hx-post="/api/voting/seen" hx-target={ "#voting-interface-" + strconv.Itoa(movieID) } hx-swap="innerHTML" class="group">
					<input type="hidden" name="movie_id" value={ strconv.Itoa(movieID) }/>
					<input type="hidden" name="seen" value="false"/>
					<button type="submit" class="btn-secondary w-full text-base py-4 flex flex-col items-center gap-3 hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-xl border-2 border-transparent hover:border-blue-300">
						<span class="text-3xl group-hover:scale-110 transition-transform duration-200">❌</span>
						<span class="font-semibold">No, I haven't seen it</span>
						<span class="text-sm opacity-80">Share your interest level</span>
					</button>
				</form>
			</div>
		</div>
	</div>
}

// EnhancedVotedState with better visual feedback
templ EnhancedVotedState(movieID int, userVote types.Vote) {
	<div class="space-y-6">
		<div class="bg-gradient-to-r from-green-600/80 to-green-500/80 backdrop-blur-sm p-6 rounded-xl border border-green-500/30">
			<div class="text-center mb-4">
				<div class="text-3xl mb-2">🎉</div>
				<p class="text-lg font-bold text-white mb-2">Vote Recorded!</p>
			</div>
			if userVote.Seen {
				<div class="text-center">
					<p class="text-green-200 font-semibold mb-2 text-lg">✅ You've seen it</p>
					<div class="bg-white/20 rounded-lg p-3 mb-4">
						<p class="text-white font-medium">
							Rating: { getEnhancedVoteLabel(userVote.Vibe) }
						</p>
					</div>
				</div>
			} else {
				<div class="text-center">
					<p class="text-green-200 font-semibold mb-2 text-lg">❌ You haven't seen it</p>
					<div class="bg-white/20 rounded-lg p-3 mb-4">
						<p class="text-white font-medium">
							Interest: { getEnhancedVoteLabel(userVote.Vibe) }
						</p>
					</div>
				</div>
			}
		</div>
		<div class="text-center">
			<p class="text-goat-400 text-sm mb-4">Moving to next movie automatically...</p>
			<button
				class="btn-secondary text-base py-3 px-6 hover:scale-105 transition-all duration-200 shadow-lg"
				hx-post="/api/voting/change-vote"
				hx-vals={ `{"movie_id":` + strconv.Itoa(movieID) + `}` }
				hx-target={ "#voting-interface-" + strconv.Itoa(movieID) }
				hx-swap="innerHTML"
			>
				🔄 Change Vote
			</button>
		</div>
	</div>
}

// Helper functions
func getEnhancedVoteLabel(vibe int) string {
	switch vibe {
	case 1:
		return "⭐ Rewatch / 🔥 Stoked"
	case 2:
		return "😊 Good / 😊 Interested"
	case 3:
		return "😐 Meh / ⏳ Later"
	default:
		return "Unknown"
	}
}

func joinStrings(strs []string, sep string) string {
	if len(strs) == 0 {
		return ""
	}
	if len(strs) == 1 {
		return strs[0]
	}

	result := strs[0]
	for i := 1; i < len(strs); i++ {
		result += sep + strs[i]
	}
	return result
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}
