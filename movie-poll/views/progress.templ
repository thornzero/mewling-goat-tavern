package views

import "fmt"

// ProgressData contains progress tracking information
type ProgressData struct {
	TotalMovies    int     `json:"total_movies"`
	VotedMovies    int     `json:"voted_movies"`
	CurrentMovie   int     `json:"current_movie"`
	ProgressPercent float64 `json:"progress_percent"`
	TimeStarted    string  `json:"time_started,omitempty"`
	EstimatedTime  string  `json:"estimated_time,omitempty"`
}

// EnhancedProgressBar renders a more detailed progress bar with additional information
templ EnhancedProgressBar(data ProgressData) {
	<div class="progress-container bg-goat-700 rounded-lg p-4 mb-6">
		<!-- Progress Header -->
		<div class="flex justify-between items-center mb-3">
			<div class="flex items-center space-x-2">
				<div class="w-3 h-3 bg-tavern-500 rounded-full"></div>
				<span class="text-sm font-medium text-goat-200">Voting Progress</span>
			</div>
			<div class="text-right">
				<div class="text-lg font-bold text-tavern-500">
					{ fmt.Sprintf("%.0f%%", data.ProgressPercent) }
				</div>
				<div class="text-xs text-goat-400">
					{ data.VotedMovies } / { data.TotalMovies } movies
				</div>
			</div>
		</div>

		<!-- Main Progress Bar -->
		<div class="w-full bg-goat-600 rounded-full h-3 mb-3">
			<div
				class="bg-gradient-to-r from-tavern-500 to-tavern-400 h-3 rounded-full transition-all duration-500 ease-out"
				style={ "width: " + fmt.Sprintf("%.1f", data.ProgressPercent) + "%" }
			></div>
		</div>

		<!-- Progress Details -->
		<div class="grid grid-cols-2 gap-4 text-xs">
			<div class="flex items-center space-x-2">
				<div class="w-2 h-2 bg-green-500 rounded-full"></div>
				<span class="text-goat-300">Completed: { data.VotedMovies }</span>
			</div>
			<div class="flex items-center space-x-2">
				<div class="w-2 h-2 bg-goat-500 rounded-full"></div>
				<span class="text-goat-300">Remaining: { data.TotalMovies - data.VotedMovies }</span>
			</div>
		</div>

		<!-- Time Information (if available) -->
	if data.TimeStarted != "" {
		<div class="mt-3 pt-3 border-t border-goat-600">
			<div class="flex justify-between text-xs text-goat-400">
				<span>Started: { data.TimeStarted }</span>
			if data.EstimatedTime != "" {
				<span>Est. completion: { data.EstimatedTime }</span>
			}
			</div>
		</div>
	}
	</div>
}

// CircularProgress renders a circular progress indicator
templ CircularProgress(data ProgressData) {
	<div class="circular-progress-container flex justify-center items-center">
		<div class="relative w-24 h-24">
			<!-- Background Circle -->
			<svg class="w-24 h-24 transform -rotate-90" viewBox="0 0 36 36">
				<path
					class="stroke-goat-600"
					stroke-width="3"
					fill="none"
					d="M18 2.0845
						a 15.9155 15.9155 0 0 1 0 31.831
						a 15.9155 15.9155 0 0 1 0 -31.831"
				></path>
				<!-- Progress Circle -->
				<path
					class="stroke-tavern-500"
					stroke-width="3"
					fill="none"
					stroke-dasharray={ fmt.Sprintf("%.1f, 100", data.ProgressPercent) }
					d="M18 2.0845
						a 15.9155 15.9155 0 0 1 0 31.831
						a 15.9155 15.9155 0 0 1 0 -31.831"
				></path>
			</svg>
			<!-- Center Text -->
			<div class="absolute inset-0 flex items-center justify-center">
				<div class="text-center">
					<div class="text-lg font-bold text-tavern-500">
						{ fmt.Sprintf("%.0f%%", data.ProgressPercent) }
					</div>
					<div class="text-xs text-goat-400">
						{ data.VotedMovies }/{ data.TotalMovies }
					</div>
				</div>
			</div>
		</div>
	</div>
}

// VotingStepIndicator shows progress through the voting steps for current movie
templ VotingStepIndicator(currentStep string, movieTitle string) {
	<div class="step-indicator bg-goat-700 rounded-lg p-4 mb-4">
		<div class="flex items-center justify-between mb-3">
			<div class="flex items-center space-x-2">
				<div class="w-3 h-3 bg-tavern-500 rounded-full animate-pulse"></div>
				<span class="text-sm font-medium text-goat-200">Current Movie</span>
			</div>
			<div class="text-right">
				<div class="text-sm text-tavern-400 font-medium">{ movieTitle }</div>
				<div class="text-xs text-goat-400">Step: { currentStep }</div>
			</div>
		</div>

		<!-- Step Progress -->
		<div class="flex items-center space-x-2">
	if currentStep == "seen" {
		<div class="w-2 h-2 rounded-full bg-tavern-500"></div>
	} else {
		<div class="w-2 h-2 rounded-full bg-green-500"></div>
	}
			<div class="text-xs text-goat-400">Seen Status</div>
			
			<div class="flex-1 h-px bg-goat-600"></div>
			
	if currentStep == "rating" || currentStep == "interest" {
		<div class="w-2 h-2 rounded-full bg-tavern-500"></div>
	} else if currentStep == "complete" {
		<div class="w-2 h-2 rounded-full bg-green-500"></div>
	} else {
		<div class="w-2 h-2 rounded-full bg-goat-500"></div>
	}
			<div class="text-xs text-goat-400">Rating</div>
			
			<div class="flex-1 h-px bg-goat-600"></div>
			
	if currentStep == "complete" {
		<div class="w-2 h-2 rounded-full bg-green-500"></div>
	} else {
		<div class="w-2 h-2 rounded-full bg-goat-500"></div>
	}
			<div class="text-xs text-goat-400">Complete</div>
		</div>
	</div>
}

// CompletionCelebration shows a celebration when voting is complete
templ CompletionCelebration() {
	<div class="completion-celebration bg-gradient-to-r from-green-600 to-green-500 rounded-lg p-6 mb-6 text-center">
		<div class="text-4xl mb-2">🎉</div>
		<div class="text-xl font-bold text-white mb-2">Voting Complete!</div>
		<div class="text-green-100 text-sm">You've voted on all movies. Check out the results!</div>
		<div class="mt-4">
			<a href="/results" class="bg-white text-green-600 font-bold py-2 px-4 rounded-lg hover:bg-green-50 transition-colors duration-200">
				View Results
			</a>
		</div>
	</div>
}

// ProgressStats shows detailed voting statistics
templ ProgressStats(data ProgressData) {
	<div class="progress-stats grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
		<div class="stat-card bg-goat-700 rounded-lg p-4 text-center">
			<div class="text-2xl font-bold text-tavern-500">{ data.VotedMovies }</div>
			<div class="text-xs text-goat-400">Movies Voted</div>
		</div>
		<div class="stat-card bg-goat-700 rounded-lg p-4 text-center">
			<div class="text-2xl font-bold text-green-500">{ data.TotalMovies - data.VotedMovies }</div>
			<div class="text-xs text-goat-400">Remaining</div>
		</div>
		<div class="stat-card bg-goat-700 rounded-lg p-4 text-center">
			<div class="text-2xl font-bold text-blue-500">{ fmt.Sprintf("%.0f%%", data.ProgressPercent) }</div>
			<div class="text-xs text-goat-400">Complete</div>
		</div>
		<div class="stat-card bg-goat-700 rounded-lg p-4 text-center">
			<div class="text-2xl font-bold text-purple-500">{ data.TotalMovies }</div>
			<div class="text-xs text-goat-400">Total Movies</div>
		</div>
	</div>
}
